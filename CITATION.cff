    alias: yharada520
license: Apache-2.0
version: 1.0.0
date-released: "2026-08-04"
keywords:
  - EDS
  - EDX
  - SEM
  - X-ray microanalysis
  - Poisson statistics
  - thin film
  - phi-rho-z
  - xraylib
  - Streamlit
